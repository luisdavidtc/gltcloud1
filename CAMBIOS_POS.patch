+def _render_pos(request, template_name, contexto):
+    """Render del formulario existente con historial acotado a la empresa activa."""
+    empresa = obtener_empresa_actual(request)
+    if empresa is None:
+        from django.core.exceptions import PermissionDenied
+        raise PermissionDenied("No hay una empresa activa.")
+    contexto = dict(contexto)
+    contexto.update({
+        'titulo': 'POS',
+        'facturas_recientes': list(
+            Sale.objects.filter(empresa=empresa).select_related('cliente')
+            .order_by('-fecha', '-pk')[:20]
+        ),
+    })
+    return render(request, template_name, contexto)
+
