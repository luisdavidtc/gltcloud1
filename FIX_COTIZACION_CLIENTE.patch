+"""
+Repara clientes creados después de la migración 0008 que no tienen su fila
+de disponibilidad (ClienteEmpresa) en su empresa propietaria. Sin esa fila
+no aparecían en Cotizaciones ("Escoja una opción válida..."). Aditiva e
+idempotente: no toca filas existentes (ni reactiva las desactivadas).
+"""
+
+from django.db import migrations
+
+
+def backfill(apps, schema_editor):
+    Client = apps.get_model('clients', 'Client')
+    ClienteEmpresa = apps.get_model('clients', 'ClienteEmpresa')
+    for cliente in Client.objects.filter(empresa__isnull=False).iterator():
+        ClienteEmpresa.objects.get_or_create(
+            cliente=cliente, empresa_id=cliente.empresa_id,
+            defaults={
+                'limite_credito': cliente.limite_credito,
+                'saldo_utilizado': cliente.saldo_utilizado,
+            },
+        )
+
+
+class Migration(migrations.Migration):
+
+    dependencies = [
+        ('clients', '0008_backfill_disponibilidad_empresa'),
+    ]
+
+    operations = [
+        migrations.RunPython(backfill, migrations.RunPython.noop),
+    ]
