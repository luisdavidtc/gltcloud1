@@ -0,0 +1,25 @@
+"""Arqueo COP: cálculo puro compartido; ningún total recibido se considera confiable."""
+import re
+from decimal import Decimal
+
+BILLETES = (200000, 100000, 50000, 20000, 10000, 5000, 2000)
+MONEDAS = (1000, 500, 200, 100, 50)
+DENOMINACIONES = BILLETES + MONEDAS
+MAX_TOTAL = Decimal('9999999999.99')
+
+
+def calcular_arqueo(cantidades):
+    if not isinstance(cantidades, dict) or set(cantidades) != {str(d) for d in DENOMINACIONES}:
+        raise ValueError('Registra la cantidad de todas las denominaciones; utiliza 0 donde no haya efectivo.')
+    normalizadas = {}
+    total = Decimal('0')
+    for denominacion in DENOMINACIONES:
+        valor = cantidades[str(denominacion)]
+        if isinstance(valor, bool) or not re.fullmatch(r'[0-9]{1,9}', str(valor)):
+            raise ValueError(f'La cantidad de ${denominacion:,} debe ser un entero mayor o igual a cero.')
+        cantidad = int(valor)
+        normalizadas[str(denominacion)] = cantidad
+        total += Decimal(denominacion) * cantidad
+    if total > MAX_TOTAL:
+        raise ValueError('El efectivo excede el máximo permitido para una sesión de caja.')
+    return normalizadas, total
