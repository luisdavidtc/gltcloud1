+from .views import cash_open, movement_create, session_detail
+
+DAY1 = datetime(2026, 10, 2, 15, tzinfo=dt_timezone.utc)
+DAY2 = datetime(2026, 10, 3, 15, tzinfo=dt_timezone.utc)
+
+
+def arqueo(**valores):
+    return {str(d): valores.get(str(d), 0) for d in DENOMINACIONES}
+
+
+@override_settings(TIME_ZONE='America/Bogota', USE_TZ=True)
+class DailyCashTests(TestCase):
