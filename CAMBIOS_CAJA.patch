@@ -0,0 +1,96 @@
+"""Única política de vigencia diaria, zona horaria y autorización de caja.
+
+Los bloqueos deben mantenerse dentro de la transacción que escribe. El
+middleware detecta vencimientos antes de la transacción de la operación;
+los servicios y modelos vuelven a validar para evitar TOCTOU.
+"""
+from datetime import datetime, time, timedelta
+from zoneinfo import ZoneInfo
+
+from django.db import transaction
+from django.utils import timezone
+
+MENSAJE_CAJA_CERRADA = 'CAJA CERRADA. Debes realizar una nueva apertura para el día de operación actual.'
+MOTIVO_AUTOMATICO = 'Cierre automático por cambio de día'
+
+
+def zona_empresa(empresa):
+    return ZoneInfo(empresa.zona_horaria or 'America/Bogota')
+
+
+def fecha_operacion(empresa, instante=None):
+    return timezone.localtime(instante or timezone.now(), zona_empresa(empresa)).date()
+
+
+def fin_jornada(sesion):
+    return timezone.make_aware(
+        datetime.combine(sesion.business_date + timedelta(days=1), time.min),
+        zona_empresa(sesion.empresa),
+    )
+
+
+def autorizar_usuario(usuario, empresa, roles=None):
+    if empresa is None or not getattr(usuario, 'is_authenticated', False) or not usuario.is_active:
+        raise ValueError('Se requiere un usuario autenticado y una empresa activa.')
+    if not usuario.is_superuser and not usuario.empresas_accesibles.filter(pk=empresa.pk).exists():
+        raise ValueError('No tienes acceso a esta empresa.')
+    if roles and not usuario.is_superuser and usuario.rol_en(empresa) not in roles:
+        raise ValueError('No tienes permisos para realizar esta operación de caja.')
+    from platform_admin.models import EmpresaModulo
+    if not EmpresaModulo.objects.filter(empresa=empresa, modulo__codigo='caja', activo=True).exists():
+        raise ValueError('El módulo Caja no está activo para esta empresa.')
+
+
+def expirar_sesiones(empresa, usuario=None):
+    """Cierre lógico idempotente. No modifica movimientos ni inventa conteos.
+
+    fecha_cierre: límite efectivo de operación (00:00 del siguiente día).
+    cierre_automatico_detectado_en: instante real de detección, incluso
+    si el servidor estuvo apagado. Cada save genera historial auditado.
+    """
+    from .models import CashSession
+    from .services import calcular_resumen_movimientos
+    if empresa is None:
+        return
+    hoy = fecha_operacion(empresa)
+    with transaction.atomic():
+        qs = CashSession.objects.select_for_update().filter(
+            empresa=empresa, estado=CashSession.Estado.ABIERTA, business_date__lt=hoy,
+        )
+        if usuario is not None:
+            qs = qs.filter(usuario=usuario)
+        for sesion in qs:
+            sesion.fecha_cierre = fin_jornada(sesion)
+            sesion.cierre_automatico_detectado_en = timezone.now()
+            sesion.saldo_final = calcular_resumen_movimientos(sesion)[0]['saldo_actual']
+            sesion.efectivo_esperado = sesion.saldo_final
+            sesion.cierre_automatico = True
+            sesion.motivo_cierre = MOTIVO_AUTOMATICO
+            sesion.estado = CashSession.Estado.CERRADA
+            sesion._history_user = None  # acción del sistema, no conteo del usuario que entra
+            sesion._change_reason = MOTIVO_AUTOMATICO
+            sesion.save(update_fields=[
+                'fecha_cierre', 'cierre_automatico_detectado_en', 'saldo_final',
+                'efectivo_esperado', 'cierre_automatico', 'motivo_cierre', 'estado',
+            ])
+
+
+def validar_sesion_actual(sesion, usuario, empresa, *, roles=None, permitir_admin=False):
+    """Devuelve la fila BLOQUEADA; requiere transaction.atomic en el llamador."""
+    from .models import CashSession
+    autorizar_usuario(usuario, empresa, roles)
+    if sesion is None or sesion.empresa_id != empresa.pk:
+        raise ValueError(MENSAJE_CAJA_CERRADA)
+    if not transaction.get_connection().in_atomic_block:
+        raise RuntimeError('La validación de escritura de caja requiere transaction.atomic().')
+    actual = CashSession.objects.select_for_update().get(pk=sesion.pk, empresa=empresa)
+    propio = actual.usuario_id == usuario.pk
+    administrador = permitir_admin and (usuario.is_superuser or usuario.rol_en(empresa) == 'admin')
+    if not propio and not administrador:
+        raise ValueError('Solo puedes operar en tu propia caja.')
+    if actual.estado != CashSession.Estado.ABIERTA or actual.business_date != fecha_operacion(empresa):
+        # Si la transacción del llamador revierte, la sesión sigue inactiva
+        # por fecha; la próxima consulta/middleware persiste su vencimiento.
+        expirar_sesiones(empresa, actual.usuario)
+        raise ValueError(MENSAJE_CAJA_CERRADA)
+    return actual
--- a/cashregister/middleware.py
+++ b/cashregister/middleware.py
@@ -0,0 +1,13 @@
+"""Detecta cambios de jornada antes de procesar cualquier vista del tenant."""
+from .daily import expirar_sesiones
+
+
+class DailyCashMiddleware:
+    def __init__(self, get_response):
+        self.get_response = get_response
+
+    def __call__(self, request):
+        empresa = getattr(request, 'empresa', None)
+        if empresa is not None and getattr(request.user, 'is_authenticated', False):
+            expirar_sesiones(empresa)
+        return self.get_response(request)
