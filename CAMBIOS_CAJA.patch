+"""Ejecutable sin Django: python -m unittest cashregister.test_denominations_pure -v."""
+import unittest
+from .denominations import DENOMINACIONES, calcular_arqueo
+
+class DenominationTests(unittest.TestCase):
+    def data(self): return {str(d): 0 for d in DENOMINACIONES}
+    def test_ejemplo_316000(self):
+        d = self.data(); d.update({'100000':2,'50000':1,'20000':3,'1000':5,'500':2})
+        self.assertEqual(calcular_arqueo(d)[1], 316000)
+    def test_cero(self): self.assertEqual(calcular_arqueo(self.data())[1], 0)
+    def test_enteros_invalidos(self):
+        for value in [-1,1.0,1.5,'1.0',True,None,'','abc','1e3','+1',' 1']:
+            with self.subTest(value=value):
+                d=self.data(); d['1000']=value
+                with self.assertRaises(ValueError): calcular_arqueo(d)
+    def test_faltantes(self):
+        with self.assertRaises(ValueError): calcular_arqueo({})
+    def test_extra(self):
+        d=self.data(); d['10']=1
+        with self.assertRaises(ValueError): calcular_arqueo(d)
+    def test_maximo(self):
+        d=self.data(); d['200000']=999999999
+        with self.assertRaises(ValueError): calcular_arqueo(d)
+    def test_normalizacion(self):
+        d={str(x):'0' for x in DENOMINACIONES}; d['500']='002'
+        self.assertEqual(calcular_arqueo(d)[0]['500'],2)
