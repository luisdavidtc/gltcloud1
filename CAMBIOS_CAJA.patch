+/** Arqueo físico. El servidor recalcula independientemente estos totales. */
+(function () {
+    'use strict';
+    const money = value => '$' + new Intl.NumberFormat('es-CO', {maximumFractionDigits: 2}).format(value);
+    function init() {
+        document.querySelectorAll('[data-cash-arqueo]').forEach(root => {
+            function update() {
+                let total = 0;
+                root.querySelectorAll('[data-denominacion]').forEach(input => {
+                    const raw = input.value;
+                    const valid = /^[0-9]{1,9}$/.test(raw);
+                    input.setCustomValidity(valid ? '' : 'Escribe un entero mayor o igual a cero, sin decimales.');
+                    const subtotal = valid ? Number(raw) * Number(input.dataset.denominacion) : 0;
+                    total += subtotal;
+                    root.querySelector('[data-subtotal="' + input.dataset.denominacion + '"]').textContent = money(subtotal);
+                });
+                root.querySelector('[data-arqueo-total]').textContent = money(total);
+                root.querySelector('[data-arqueo-total-input]').value = String(total);
+                const diff = root.querySelector('[data-arqueo-diferencia]');
+                if (diff) {
+                    const expected = Number((root.dataset.esperado || '0').replace(',', '.'));
+                    root.querySelector('[data-arqueo-esperado]').textContent = money(expected);
+                    const delta = total - expected;
+                    diff.textContent = (delta > 0 ? '+' : '') + money(delta);
+                    diff.classList.toggle('text-danger', delta < 0);
+                    diff.classList.toggle('text-success', delta >= 0);
+                }
+            }
+            root.addEventListener('input', update);
+            const form = root.closest('form');
+            if (form) form.addEventListener('reset', () => setTimeout(update, 0));
+            update();
+        });
+    }
+    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
+})();
