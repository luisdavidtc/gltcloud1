+        self.now = self.clock.start()
+        self.addCleanup(self.clock.stop)
+        self.empresa = Empresa.objects.create(nombre_comercial='Caja A', nit='100', estado='activa')
+        self.otra = Empresa.objects.create(nombre_comercial='Caja B', nit='200', estado='activa')
+        self.usuario = CustomUser.objects.create_user(username='cajero', password='clave', empresa=self.empresa, role='cajero')
+        self.otro_usuario = CustomUser.objects.create_user(username='otro', password='clave', empresa=self.otra, role='cajero')
+        self.modulo, _ = Modulo.objects.get_or_create(codigo='caja', defaults={'nombre': 'Caja'})
+        EmpresaModulo.objects.update_or_create(empresa=self.empresa, modulo=self.modulo, defaults={'activo': True})
+        EmpresaModulo.objects.update_or_create(empresa=self.otra, modulo=self.modulo, defaults={'activo': True})
+        self.cliente = Client.objects.create(empresa=self.empresa, nombre='Cliente', documento='123')
+        self.sesion = self.abrir()
+
+    def abrir(self):
+        return CashSession.objects.create(
+            empresa=self.empresa, usuario=self.usuario, saldo_inicial=999,
+            apertura_denominaciones=arqueo(**{'100000': 2, '50000': 1}),
+        )
+
+    def venta(self, sesion=None):
